;; lg-drive — app-scoped bb.edn for the Clojure port (ADR-2606280030).
;; Mirrors the repo-root langgraph-clj / langchain-clj git coordinates so the
;; clj twin is portable (loads under bb from this dir without touching repo-root
;; bb.edn). `bb run_tests.clj` runs the ported clojure.test suites; `bb serve`
;; starts the httpkit XRPC server (kotoba-backed).
{:paths ["clj"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {serve {:doc "Start the lg-drive XRPC server (httpkit, kotoba-backed)."
         :requires ([lg-drive.server :as server])
         :task (apply server/-main *command-line-args*)}}}
