(ns drive.trash
  "drive 表示・更新判定コア — itonami dapp bundle（pure, :effects #{}）。

  ファイル一覧と更新の判定（正本: lg/clj/lg_drive/handlers.cljk —
  Google Drive v3 / OneDrive 互換の canonical 実装。storage-agnostic）:

  - **trashed な項目は一覧に出さない**（includeTrashed=true のときだけ出す）。
    「ゴミ箱の可視性は明示的な要求でのみ」。
  - update は calendar と同じ ifSequence 競合規則（不一致 = conflict = 412）。
  - patch の白名单は **name / parentId / trashed / starred の 4 つのみ**
    （present なものだけ）。
  - create の既定は trashed false。

  list-judgment: 1 = 一覧に出す / 0 = 除外（trashed かつ include 無し）
  update-judgment の戻り: 0 = 進行 / 1 = not-found / 2 = conflict
  patch-admissible: 1 = 白名单内かつ present
  patch-field-code: 0 name / 1 parentId / 2 trashed / 3 starred

  実行 host はスカラーのみ = KIR v3 / i64/direct ABI（kernel/selfhost 両対応）。

  テストはゼロ引数 test-*、戻り 1/0:
  <amu> test aiueos/drive_trash.cljk"
  (:export [main list-judgment update-judgment patch-admissible patch-field-ok
            test-list test-list-trashed test-update test-update-conflict
            test-update-missing test-patch test-fail-closed]))

(defn main [] :i64
  0)

(defn list-judgment [trashed :i64 include-trashed :i64] :i64
  (if (and (= trashed 1) (= include-trashed 0)) 0 1))

(defn update-judgment [has-file :i64 has-if-seq :i64 stored-seq :i64 if-seq :i64] :i64
  (if (= has-file 0)
    1
    (if (and (= has-if-seq 1) (not= stored-seq if-seq))
      2
      0)))

(defn patch-field-ok [field-code :i64] :i64
  (if (and (>= field-code 0) (<= field-code 3)) 1 0))

(defn patch-admissible [field-code :i64 present :i64] :i64
  (if (and (= (patch-field-ok field-code) 1) (= present 1)) 1 0))

;; --- tests（戻り 1 = pass） ------------------------------------------------

(defn test-list [] :i64
  (if (= (+ (list-judgment 0 0) (list-judgment 0 1)) 2) 1 0))

(defn test-list-trashed [] :i64
  ;; ゴミ箱は明示要求でのみ可視
  (if (= (+ (list-judgment 1 0) (list-judgment 1 1)) 1) 1 0))

(defn test-update [] :i64
  (if (= (update-judgment 1 1 3 3) 0) 1 0))

(defn test-update-conflict [] :i64
  (if (= (update-judgment 1 1 3 2) 2) 1 0))

(defn test-update-missing [] :i64
  (if (= (update-judgment 0 0 0 0) 1) 1 0))

(defn test-patch [] :i64
  ;; 白名单 4 つ（name/parentId/trashed/starred）は present なら可
  (if (= (+ (patch-admissible 0 1) (patch-admissible 3 1) (patch-admissible 4 1)
            (patch-admissible 1 0) (patch-admissible -1 1))
         2)
    1 0))

(defn test-fail-closed [] :i64
  ;; 白名单外は present でも不可
  (if (= (patch-admissible 7 1) 0) 1 0))
